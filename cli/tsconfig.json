{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": "..", // the CLI imports types and schemas from ../server/src
    "noEmit": true // run with tsx, never compiled to dist/
  },
  "include": ["src", "test"]
}
